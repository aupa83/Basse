rules_version = '2';
// Règles de sécurité de la base Outils basse.
// Chacun ne voit que sa propre fiche ; seul l'administrateur (role "admin", statut "ok")
// voit tous les comptes, change les statuts et lit les messages.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().role == 'admin' && me().status == 'ok';
    }
    function shortText(v, max) { return v is string && v.size() <= max; }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // Inscription : sa propre fiche, toujours « en attente », sans rôle.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'status', 'createdAt', 'lastSeen'])
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && shortText(request.resource.data.name, 60)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSeen == request.time;
      // L'utilisateur ne peut changer que sa date de passage ; l'administrateur, le statut des autres.
      allow update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
          && request.resource.data.lastSeen == request.time)
        || (isAdmin() && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['pending', 'ok', 'blocked']);
      allow delete: if false;
    }

    match /messages/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'subject', 'text', 'createdAt', 'read', 'version', 'device'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && shortText(request.resource.data.name, 60)
        && shortText(request.resource.data.subject, 40)
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && shortText(request.resource.data.version, 40)
        && shortText(request.resource.data.device, 300)
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
    }
  }
}
